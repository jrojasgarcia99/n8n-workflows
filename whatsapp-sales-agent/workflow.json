    {
      "parameters": {
        "toolDescription": "Busca un producto en la tienda Shopify por nombre y devuelve precio y disponibilidad.",
        "url": "=https://TU_TIENDA.myshopify.com/admin/api/2024-01/products.json?title={query}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "placeholderDefinitions": {
          "values": [
            {
              "name": "query",
              "description": "Nombre o palabra clave del producto",
              "type": "string"
            }
          ]
        }
      },
      "id": "7e752b0c-29e6-4d99-9559-c848752671f3",
      "name": "Tool: Buscar producto en Shopify",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [
        2288,
        464
      ]
    },
    {
      "parameters": {
        "toolDescription": "Genera un link de pago en Tilopay para un monto y descripción dados y lo devuelve al agente.",
        "method": "POST",
        "url": "https://app.tilopay.com/api/v1/payment-links",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"amount\": {amount}, \"currency\": \"CRC\", \"description\": \"{descripcion}\"}",
        "placeholderDefinitions": {
          "values": [
            {
              "name": "amount",
              "description": "Monto total a cobrar",
              "type": "number"
            },
            {
              "name": "descripcion",
              "description": "Descripción del producto/pedido",
              "type": "string"
            }
          ]
        }
      },
      "id": "64fa812b-d51b-489b-807c-28afe6ae465b",
      "name": "Tool: Generar link de pago Tilopay",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
