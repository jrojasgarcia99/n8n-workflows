    {
      "parameters": {
        "jsCode": "const entry = $json.body.entry?.[0]?.changes?.[0]?.value;\nconst msg = entry?.messages?.[0];\nif (!msg) { return []; }\nreturn [{\n  json: {\n    telefono: msg.from,\n    nombre: entry.contacts?.[0]?.profile?.name || \"\",\n    tipo: msg.type,\n    texto: msg.text?.body || \"\",\n    message_id: msg.id\n  }\n}];"
      },
      "id": "bdf80eca-1ff1-4d5b-a636-d18410949d80",
      "name": "Extraer datos del mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        256
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
